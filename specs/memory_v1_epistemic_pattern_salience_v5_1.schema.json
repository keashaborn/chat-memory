{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verbalsage.internal/specs/memory_v1_epistemic_pattern_salience_v5_1.schema.json",
  "title": "Memory V1 epistemic, pattern, and salience snapshot V5.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "policy_version",
    "source_registry_version",
    "target",
    "evidence_assessment",
    "pattern_assessment",
    "salience_features",
    "retrieval_history",
    "reason_codes",
    "input_manifest_sha256",
    "packet_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "memory_v1_epistemic_pattern_salience_v5_1"
    },
    "policy_version": {
      "const": "memory_v1_epistemic_pattern_salience_policy_v5_1"
    },
    "source_registry_version": {
      "const": "memory_predicate_registry_v5_1"
    },
    "target": {"$ref": "#/$defs/target"},
    "evidence_assessment": {"$ref": "#/$defs/evidence_assessment"},
    "pattern_assessment": {
      "oneOf": [
        {"$ref": "#/$defs/pattern_assessment"},
        {"type": "null"}
      ]
    },
    "salience_features": {"$ref": "#/$defs/salience_features"},
    "retrieval_history": {"$ref": "#/$defs/retrieval_history"},
    "reason_codes": {"$ref": "#/$defs/reason_codes"},
    "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "packet_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "nullable_uuid": {
      "oneOf": [
        {"$ref": "#/$defs/uuid"},
        {"type": "null"}
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unit_interval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,99}$"
      }
    },
    "uuid_set": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/uuid"}
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_kind",
        "target_id",
        "target_revision_number",
        "semantic_key_sha256"
      ],
      "properties": {
        "target_kind": {
          "enum": [
            "claim",
            "preference",
            "project_knowledge",
            "pattern_hypothesis"
          ]
        },
        "target_id": {"$ref": "#/$defs/uuid"},
        "target_revision_number": {
          "type": "integer",
          "minimum": 1
        },
        "semantic_key_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directness",
        "source_reliability",
        "independence",
        "relevance",
        "temporal_fit",
        "specificity",
        "extraction_quality",
        "support_strength",
        "opposition_strength"
      ],
      "properties": {
        "directness": {"$ref": "#/$defs/unit_interval"},
        "source_reliability": {"$ref": "#/$defs/unit_interval"},
        "independence": {"$ref": "#/$defs/unit_interval"},
        "relevance": {"$ref": "#/$defs/unit_interval"},
        "temporal_fit": {"$ref": "#/$defs/unit_interval"},
        "specificity": {"$ref": "#/$defs/unit_interval"},
        "extraction_quality": {"$ref": "#/$defs/unit_interval"},
        "support_strength": {"$ref": "#/$defs/unit_interval"},
        "opposition_strength": {"$ref": "#/$defs/unit_interval"}
      }
    },
    "evidence_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_state",
        "supporting_observation_count",
        "opposing_observation_count",
        "qualifying_observation_count",
        "corrective_observation_count",
        "independent_support_cluster_count",
        "independent_opposition_cluster_count",
        "source_diversity_count",
        "supporting_observation_ids",
        "opposing_observation_ids",
        "dimensions",
        "method",
        "method_version",
        "inputs_sha256"
      ],
      "properties": {
        "assessment_state": {
          "enum": [
            "insufficient",
            "emerging",
            "supported",
            "contested",
            "superseded",
            "retracted"
          ]
        },
        "supporting_observation_count": {"type": "integer", "minimum": 0},
        "opposing_observation_count": {"type": "integer", "minimum": 0},
        "qualifying_observation_count": {"type": "integer", "minimum": 0},
        "corrective_observation_count": {"type": "integer", "minimum": 0},
        "independent_support_cluster_count": {
          "type": "integer",
          "minimum": 0
        },
        "independent_opposition_cluster_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_diversity_count": {"type": "integer", "minimum": 0},
        "supporting_observation_ids": {"$ref": "#/$defs/uuid_set"},
        "opposing_observation_ids": {"$ref": "#/$defs/uuid_set"},
        "dimensions": {"$ref": "#/$defs/evidence_dimensions"},
        "method": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,99}$"
        },
        "method_version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        },
        "inputs_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pattern_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern_kind",
        "pattern_state",
        "occurrence_count",
        "counterexample_count",
        "independent_episode_count",
        "distinct_temporal_bucket_count",
        "temporal_basis_observation_ids",
        "automatic_review_eligible",
        "identity_inference_forbidden",
        "causal_inference_forbidden",
        "reason_codes"
      ],
      "properties": {
        "pattern_kind": {
          "enum": [
            "recurrence",
            "persistence",
            "transition",
            "trend",
            "co_occurrence",
            "sequence"
          ]
        },
        "pattern_state": {
          "enum": [
            "insufficient",
            "emerging",
            "supported",
            "contested",
            "ended",
            "superseded",
            "retracted"
          ]
        },
        "occurrence_count": {"type": "integer", "minimum": 0},
        "counterexample_count": {"type": "integer", "minimum": 0},
        "independent_episode_count": {"type": "integer", "minimum": 0},
        "distinct_temporal_bucket_count": {
          "type": "integer",
          "minimum": 0
        },
        "temporal_basis_observation_ids": {"$ref": "#/$defs/uuid_set"},
        "automatic_review_eligible": {"type": "boolean"},
        "identity_inference_forbidden": {"const": true},
        "causal_inference_forbidden": {"const": true},
        "reason_codes": {"$ref": "#/$defs/reason_codes"}
      }
    },
    "salience_features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "importance",
        "frequency",
        "recency",
        "emotional_significance",
        "goal_relevance",
        "future_utility",
        "retrieval_utility",
        "contradiction_pressure",
        "method_version",
        "signal_manifest_sha256"
      ],
      "properties": {
        "importance": {"$ref": "#/$defs/unit_interval"},
        "frequency": {"$ref": "#/$defs/unit_interval"},
        "recency": {"$ref": "#/$defs/unit_interval"},
        "emotional_significance": {"$ref": "#/$defs/unit_interval"},
        "goal_relevance": {"$ref": "#/$defs/unit_interval"},
        "future_utility": {"$ref": "#/$defs/unit_interval"},
        "retrieval_utility": {"$ref": "#/$defs/unit_interval"},
        "contradiction_pressure": {"$ref": "#/$defs/unit_interval"},
        "method_version": {
          "const": "memory_v1_salience_features_v5_1"
        },
        "signal_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "retrieval_history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_count",
        "selected_count",
        "injected_count",
        "explicitly_helpful_count",
        "explicitly_confirmed_count",
        "corrected_count",
        "not_relevant_count",
        "caused_confusion_count",
        "last_retrieval_trace_id"
      ],
      "properties": {
        "eligible_count": {"type": "integer", "minimum": 0},
        "selected_count": {"type": "integer", "minimum": 0},
        "injected_count": {"type": "integer", "minimum": 0},
        "explicitly_helpful_count": {"type": "integer", "minimum": 0},
        "explicitly_confirmed_count": {"type": "integer", "minimum": 0},
        "corrected_count": {"type": "integer", "minimum": 0},
        "not_relevant_count": {"type": "integer", "minimum": 0},
        "caused_confusion_count": {"type": "integer", "minimum": 0},
        "last_retrieval_trace_id": {"$ref": "#/$defs/nullable_uuid"}
      }
    }
  }
}
