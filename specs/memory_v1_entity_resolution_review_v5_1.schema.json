{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verbalsage.internal/specs/memory_v1_entity_resolution_review_v5_1.schema.json",
  "title": "Memory V1 owner-scoped entity resolution review packet V5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_envelope",
    "predicate_registry_version",
    "entity_normalization_version",
    "resolver",
    "resolver_version",
    "resolutions",
    "packet_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "memory_v1_entity_resolution_review_v5_1"
    },
    "source_envelope": {
      "$ref": "#/$defs/source_envelope"
    },
    "predicate_registry_version": {
      "const": "memory_predicate_registry_v5_1"
    },
    "entity_normalization_version": {
      "const": "memory_entity_normalization_v5"
    },
    "resolver": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "resolver_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "resolutions": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/resolution"
      }
    },
    "packet_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_uuid": {
      "oneOf": [
        {"$ref": "#/$defs/uuid"},
        {"type": "null"}
      ]
    },
    "nullable_string": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 500},
        {"type": "null"}
      ]
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,99}$"
      }
    },
    "source_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "source_system",
        "source_external_id",
        "source_sha256",
        "source_recorded_at"
      ],
      "properties": {
        "job_id": {"$ref": "#/$defs/uuid"},
        "source_system": {"const": "public.chat_log"},
        "source_external_id": {"$ref": "#/$defs/uuid"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "feature_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_status",
        "entity_type_match",
        "exact_canonical_name",
        "exact_alias",
        "relationship_role_supported",
        "source_local_coreference",
        "graph_neighbor_supported",
        "conflicting_attribute_count",
        "same_name_candidate_count"
      ],
      "properties": {
        "active_status": {"type": "boolean"},
        "entity_type_match": {"type": "boolean"},
        "exact_canonical_name": {"type": "boolean"},
        "exact_alias": {"type": "boolean"},
        "relationship_role_supported": {"type": "boolean"},
        "source_local_coreference": {"type": "boolean"},
        "graph_neighbor_supported": {"type": "boolean"},
        "conflicting_attribute_count": {"type": "integer", "minimum": 0},
        "same_name_candidate_count": {"type": "integer", "minimum": 0}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_type",
        "features",
        "exclusion_reasons"
      ],
      "properties": {
        "entity_id": {"$ref": "#/$defs/uuid"},
        "entity_type": {
          "enum": [
            "self",
            "person",
            "animal",
            "organization",
            "place",
            "project",
            "object",
            "concept"
          ]
        },
        "features": {"$ref": "#/$defs/feature_vector"},
        "exclusion_reasons": {"$ref": "#/$defs/reason_codes"}
      }
    },
    "proposed_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_type",
        "identity_state",
        "canonical_name",
        "display_label",
        "creation_reason"
      ],
      "properties": {
        "entity_type": {
          "enum": [
            "person",
            "animal",
            "organization",
            "place",
            "object",
            "concept"
          ]
        },
        "identity_state": {
          "enum": ["named", "role_only", "anonymous"]
        },
        "canonical_name": {"$ref": "#/$defs/nullable_string"},
        "display_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "creation_reason": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,99}$"
        }
      }
    },
    "nullable_proposed_entity": {
      "oneOf": [
        {"$ref": "#/$defs/proposed_entity"},
        {"type": "null"}
      ]
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_ref",
        "mention_sha256",
        "action",
        "decision_state",
        "selected_entity_id",
        "proposed_entity",
        "candidate_set_sha256",
        "candidate_set",
        "review_reason_codes",
        "decision_sha256"
      ],
      "properties": {
        "entity_ref": {
          "type": "string",
          "pattern": "^e[0-9]{2}$"
        },
        "mention_sha256": {"$ref": "#/$defs/sha256"},
        "action": {
          "enum": ["link_existing", "create_new", "defer", "reject"]
        },
        "decision_state": {
          "enum": [
            "auto_link_eligible",
            "manual_review_required",
            "deferred",
            "rejected"
          ]
        },
        "selected_entity_id": {"$ref": "#/$defs/nullable_uuid"},
        "proposed_entity": {"$ref": "#/$defs/nullable_proposed_entity"},
        "candidate_set_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_set": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/candidate"}
        },
        "review_reason_codes": {"$ref": "#/$defs/reason_codes"},
        "decision_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
