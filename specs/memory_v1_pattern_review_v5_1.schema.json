{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verbalsage.internal/specs/memory_v1_pattern_review_v5_1.schema.json",
  "title": "Memory V1 governed pattern review proposal V5.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "policy_version",
    "source_registry_version",
    "pattern_key_sha256",
    "pattern_kind",
    "subject_entity_id",
    "secondary_entity_id",
    "predicate_family",
    "sensitivity",
    "pattern_state",
    "occurrence_count",
    "counterexample_count",
    "independent_episode_count",
    "distinct_temporal_bucket_count",
    "valid_from",
    "valid_to",
    "automatic_review_eligible",
    "identity_inference_forbidden",
    "causal_inference_forbidden",
    "reason_codes",
    "method_version",
    "input_manifest_sha256",
    "observation_items",
    "proposal_sha256"
  ],
  "properties": {
    "contract_version": {"const": "memory_v1_pattern_review_v5_1"},
    "policy_version": {
      "const": "memory_v1_epistemic_pattern_salience_policy_v5_1"
    },
    "source_registry_version": {"const": "memory_predicate_registry_v5_1"},
    "pattern_key_sha256": {"$ref": "#/$defs/sha256"},
    "pattern_kind": {
      "enum": [
        "recurrence",
        "persistence",
        "transition",
        "trend",
        "co_occurrence",
        "sequence"
      ]
    },
    "subject_entity_id": {"$ref": "#/$defs/uuid"},
    "secondary_entity_id": {"$ref": "#/$defs/nullable_uuid"},
    "predicate_family": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,239}$"
    },
    "sensitivity": {"enum": ["low", "medium", "high", "restricted"]},
    "pattern_state": {
      "enum": [
        "insufficient",
        "emerging",
        "supported",
        "contested",
        "ended",
        "superseded",
        "retracted"
      ]
    },
    "occurrence_count": {"type": "integer", "minimum": 0},
    "counterexample_count": {"type": "integer", "minimum": 0},
    "independent_episode_count": {"type": "integer", "minimum": 0},
    "distinct_temporal_bucket_count": {"type": "integer", "minimum": 0},
    "valid_from": {"$ref": "#/$defs/nullable_date"},
    "valid_to": {"$ref": "#/$defs/nullable_date"},
    "automatic_review_eligible": {"type": "boolean"},
    "identity_inference_forbidden": {"const": true},
    "causal_inference_forbidden": {"const": true},
    "reason_codes": {"$ref": "#/$defs/reason_codes"},
    "method_version": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "observation_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/observation_item"}
    },
    "proposal_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "nullable_uuid": {
      "oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]
    },
    "nullable_date": {
      "oneOf": [{"type": "string", "format": "date"}, {"type": "null"}]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,99}$"
      }
    },
    "observation_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "evidence_id",
        "observation_role",
        "episode_key_sha256",
        "independence_key_sha256",
        "temporal_bucket_sha256",
        "observation_sha256",
        "evidence_content_sha256"
      ],
      "properties": {
        "observation_id": {"$ref": "#/$defs/uuid"},
        "evidence_id": {"$ref": "#/$defs/uuid"},
        "observation_role": {
          "enum": ["occurrence", "counterexample", "boundary", "context"]
        },
        "episode_key_sha256": {"$ref": "#/$defs/sha256"},
        "independence_key_sha256": {"$ref": "#/$defs/sha256"},
        "temporal_bucket_sha256": {"$ref": "#/$defs/sha256"},
        "observation_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
