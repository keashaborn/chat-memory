{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verbalsage.internal/specs/memory_v1_projection_plan_v5.schema.json",
  "title": "Memory V1 trusted projection plan V5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "predicate_registry_version",
    "projection_policy_version",
    "projector",
    "projector_version",
    "projections",
    "packet_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "memory_v1_projection_plan_v5"
    },
    "predicate_registry_version": {
      "const": "memory_predicate_registry_v5"
    },
    "projection_policy_version": {
      "const": "memory_projection_policy_v5"
    },
    "projector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "projector_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "projections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/projection"
      }
    },
    "packet_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_uuid": {
      "oneOf": [
        {"$ref": "#/$defs/uuid"},
        {"type": "null"}
      ]
    },
    "nullable_integer": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "null"}
      ]
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,99}$"
      }
    },
    "observation_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "observation_sha256",
        "stance"
      ],
      "properties": {
        "observation_id": {"$ref": "#/$defs/uuid"},
        "observation_sha256": {"$ref": "#/$defs/sha256"},
        "stance": {
          "enum": ["supports", "opposes", "context", "correction_target"]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_entity_id",
        "predicate",
        "object_kind",
        "object_entity_id",
        "object_literal_sha256",
        "polarity",
        "modality",
        "semantic_key_sha256"
      ],
      "properties": {
        "subject_entity_id": {"$ref": "#/$defs/uuid"},
        "predicate": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{1,127}$"
        },
        "object_kind": {"enum": ["entity", "literal"]},
        "object_entity_id": {"$ref": "#/$defs/nullable_uuid"},
        "object_literal_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "polarity": {"enum": ["affirmed", "negated"]},
        "modality": {
          "enum": [
            "asserted",
            "negated",
            "uncertain",
            "corrective",
            "proposed",
            "planned",
            "endorsed",
            "reported_observation"
          ]
        },
        "semantic_key_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "aggregate_id",
        "expected_revision_number",
        "reason_codes"
      ],
      "properties": {
        "action": {
          "enum": ["create", "reinforce", "revise", "relate", "defer", "reject"]
        },
        "aggregate_id": {"$ref": "#/$defs/nullable_uuid"},
        "expected_revision_number": {"$ref": "#/$defs/nullable_integer"},
        "reason_codes": {"$ref": "#/$defs/reason_codes"}
      }
    },
    "temporal_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_source",
        "materialization",
        "source_observation_id"
      ],
      "properties": {
        "canonical_source": {"const": "memory.observation_temporal"},
        "materialization": {"enum": ["link_only", "state_validity_only"]},
        "source_observation_id": {"$ref": "#/$defs/nullable_uuid"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "authorization_required", "reason_codes"],
      "properties": {
        "state": {
          "enum": [
            "auto_apply_eligible",
            "manual_review_required",
            "deferred",
            "rejected"
          ]
        },
        "authorization_required": {"type": "boolean"},
        "reason_codes": {"$ref": "#/$defs/reason_codes"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_type",
        "target_lane",
        "target_aggregate_id",
        "reason_code"
      ],
      "properties": {
        "relation_type": {
          "enum": [
            "contradicts",
            "supersedes",
            "corrects",
            "qualifies",
            "depends_on",
            "derived_from"
          ]
        },
        "target_lane": {"enum": ["claim", "preference", "project_knowledge"]},
        "target_aggregate_id": {"$ref": "#/$defs/uuid"},
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,99}$"
        }
      }
    },
    "claim_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "claim_class",
        "canonical_text",
        "surface_policy"
      ],
      "properties": {
        "kind": {"const": "claim"},
        "claim_class": {
          "enum": ["direct_claim", "supportive_context", "correction", "never_surface"]
        },
        "canonical_text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "surface_policy": {
          "enum": [
            "direct_or_relevant",
            "mention_when_directly_relevant",
            "explicit_recall_only",
            "normalization_only",
            "never"
          ]
        }
      }
    },
    "preference_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "preference_class",
        "domain",
        "preference_key",
        "value",
        "preference_polarity",
        "scope",
        "stability",
        "surface_policy"
      ],
      "properties": {
        "kind": {"const": "preference"},
        "preference_class": {"enum": ["life", "response"]},
        "domain": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "preference_key": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,239}$"},
        "value": {},
        "preference_polarity": {
          "enum": ["likes", "dislikes", "prefers", "avoids", "not_applicable"]
        },
        "scope": {"const": "user_global"},
        "stability": {"enum": ["tentative", "contextual", "stable"]},
        "surface_policy": {
          "enum": [
            "relevant_recommendation_or_explicit_recall",
            "zero_token_control_only",
            "never"
          ]
        }
      }
    },
    "project_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "project_id",
        "knowledge_kind",
        "knowledge_key",
        "canonical_text",
        "document_state",
        "authority_level",
        "surface_policy"
      ],
      "properties": {
        "kind": {"const": "project_knowledge"},
        "project_id": {"$ref": "#/$defs/uuid"},
        "knowledge_kind": {
          "enum": ["constraint", "current_state", "proposed_feature", "requirement"]
        },
        "knowledge_key": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,239}$"},
        "canonical_text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "document_state": {
          "enum": ["unverified", "working", "proposed", "ratified", "historical", "superseded"]
        },
        "authority_level": {
          "enum": [
            "user_reported",
            "user_ratified",
            "approved_spec",
            "system_observed",
            "external_reference"
          ]
        },
        "surface_policy": {"const": "exact_project_scope_only"}
      }
    },
    "payload": {
      "oneOf": [
        {"$ref": "#/$defs/claim_payload"},
        {"$ref": "#/$defs/preference_payload"},
        {"$ref": "#/$defs/project_payload"}
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_ref",
        "lane",
        "observation_inputs",
        "identity",
        "target",
        "temporal_policy",
        "review",
        "relations",
        "payload"
      ],
      "properties": {
        "projection_ref": {"type": "string", "pattern": "^p[0-9]{2}$"},
        "lane": {"enum": ["claim", "preference", "project_knowledge"]},
        "observation_inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/observation_input"}
        },
        "identity": {"$ref": "#/$defs/identity"},
        "target": {"$ref": "#/$defs/target"},
        "temporal_policy": {"$ref": "#/$defs/temporal_policy"},
        "review": {"$ref": "#/$defs/review"},
        "relations": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/relation"}
        },
        "payload": {"$ref": "#/$defs/payload"}
      }
    }
  }
}
