{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_v1_v5_local_status_v1",
  "title": "Memory V1 private inference operational status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "observed_at",
    "state",
    "activity",
    "eligible_backlog",
    "active_leases",
    "last_successful_dispatch_at",
    "last_terminal_outcome",
    "circuit",
    "quota",
    "throughput",
    "runtime_health"
  ],
  "properties": {
    "contract_version": {
      "const": "memory_v1_v5_local_status_v1"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "running",
        "idle_no_eligible_work",
        "quota_limited",
        "circuit_blocked",
        "unhealthy"
      ]
    },
    "activity": {
      "enum": [
        "active",
        "dispatch_ready",
        "none",
        "blocked"
      ]
    },
    "eligible_backlog": {
      "type": "integer",
      "minimum": 0
    },
    "active_leases": {
      "type": "integer",
      "minimum": 0
    },
    "last_successful_dispatch_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_terminal_outcome": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "outcome",
            "outcome_class",
            "reason_code"
          ],
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "outcome": {
              "enum": [
                "accepted",
                "rejected"
              ]
            },
            "outcome_class": {
              "enum": [
                "success",
                "record_terminal",
                "systemic_threshold",
                "systemic_immediate",
                "systemic_unclassified"
              ]
            },
            "reason_code": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z][a-z0-9_]{1,99}$"
            }
          }
        }
      ]
    },
    "circuit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "systemic_failure_count",
        "open_reason",
        "opened_at",
        "cooldown_until",
        "blocked_wakeup_count"
      ],
      "properties": {
        "state": {
          "enum": [
            "closed",
            "open",
            "half_open_ready",
            "half_open_inflight"
          ]
        },
        "systemic_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "open_reason": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]{1,99}$"
        },
        "opened_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "cooldown_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "blocked_wakeup_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rolling_window_seconds",
        "max_reserved_jobs",
        "reserved_jobs"
      ],
      "properties": {
        "rolling_window_seconds": {
          "type": "integer",
          "minimum": 3600
        },
        "max_reserved_jobs": {
          "type": "integer",
          "minimum": 1
        },
        "reserved_jobs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "throughput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_1h",
        "completed_24h",
        "accepted_24h",
        "record_terminal_24h",
        "systemic_failure_24h"
      ],
      "properties": {
        "completed_1h": {
          "type": "integer",
          "minimum": 0
        },
        "completed_24h": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_24h": {
          "type": "integer",
          "minimum": 0
        },
        "record_terminal_24h": {
          "type": "integer",
          "minimum": 0
        },
        "systemic_failure_24h": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runtime_health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "healthy",
        "reason_codes"
      ],
      "properties": {
        "healthy": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,99}$"
          }
        }
      }
    }
  }
}
