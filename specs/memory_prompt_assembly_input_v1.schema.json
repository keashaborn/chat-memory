        "scores": {
          "$ref": "#/$defs/MemorySelectionScoresV1",
          "default": {
            "aggregate_salience": null,
            "contradiction_pressure": null,
            "emotional_significance": null,
            "frequency": null,
            "future_utility": null,
            "goal_relevance": null,
            "importance": null,
            "recency": null,
            "retrieval_history": null,
            "semantic_relevance": null
          }
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "source_content_sha256": {
          "title": "Source Content Sha256",
          "type": "string"
        },
        "source_contract": {
          "$ref": "#/$defs/SourceContractVersionV1"
        },
        "superseded_by": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By"
        },
        "surface_policy": {
          "$ref": "#/$defs/SurfacePolicy"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
