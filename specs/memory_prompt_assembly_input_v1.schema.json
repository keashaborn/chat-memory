        "owner_user_id",
        "lane",
        "record_id",
        "revision_id",
        "source_contract",
        "source_content_sha256",
        "rank",
        "surface_policy",
        "sensitivity",
        "use_instruction",
        "token_estimate",
        "evidence_refs",
        "observation_refs",
