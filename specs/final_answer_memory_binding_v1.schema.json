{
  "$defs": {
    "MemoryAnswerBindingItemV1": {
      "additionalProperties": false,
      "properties": {
        "actual_prompt_tokens": {
          "maximum": 1200,
          "minimum": 0,
          "title": "Actual Prompt Tokens",
          "type": "integer"
        },
        "answer_model_exposed": {
          "title": "Answer Model Exposed",
          "type": "boolean"
        },
        "injected": {
          "title": "Injected",
          "type": "boolean"
        },
        "record": {
          "$ref": "#/$defs/MemoryRecordRefV1"
        },
        "rendered_fragment_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rendered Fragment Sha256"
        }
      },
      "required": [
        "record",
        "injected",
        "answer_model_exposed",
        "actual_prompt_tokens",
        "rendered_fragment_sha256"
      ],
      "title": "MemoryAnswerBindingItemV1",
      "type": "object"
    },
    "MemoryAnswerControlBindingItemV1": {
      "additionalProperties": false,
      "properties": {
        "applied": {
          "title": "Applied",
          "type": "boolean"
        },
        "control": {
          "$ref": "#/$defs/MemoryControlRefV1"
        }
      },
      "required": [
        "control",
        "applied"
      ],
      "title": "MemoryAnswerControlBindingItemV1",
      "type": "object"
    },
    "MemoryControlRefV1": {
      "additionalProperties": false,
      "properties": {
        "control_sha256": {
          "title": "Control Sha256",
          "type": "string"
        },
        "owner_user_id": {
          "format": "uuid",
          "title": "Owner User Id",
          "type": "string"
        },
        "record_id": {
          "format": "uuid",
          "title": "Record Id",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "source_content_sha256": {
          "title": "Source Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "owner_user_id",
        "record_id",
        "revision_id",
        "source_content_sha256",
        "control_sha256"
      ],
      "title": "MemoryControlRefV1",
      "type": "object"
    },
    "MemoryLane": {
      "enum": [
        "claim",
        "preference",
        "project_knowledge"
      ],
      "title": "MemoryLane",
      "type": "string"
    },
    "MemoryRecordRefV1": {
      "additionalProperties": false,
      "properties": {
        "lane": {
          "$ref": "#/$defs/MemoryLane"
        },
        "owner_user_id": {
          "format": "uuid",
          "title": "Owner User Id",
          "type": "string"
        },
        "rank": {
          "maximum": 8,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "record_id": {
          "format": "uuid",
          "title": "Record Id",
          "type": "string"
        },
        "revision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revision Id"
        },
        "source_content_sha256": {
          "title": "Source Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "owner_user_id",
        "lane",
        "record_id",
        "revision_id",
        "source_content_sha256",
        "rank"
      ],
      "title": "MemoryRecordRefV1",
      "type": "object"
    }
  },
  "$id": "https://verbalsage.internal/specs/final_answer_memory_binding_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_prompt_memory_tokens": {
      "maximum": 1200,
      "minimum": 0,
      "title": "Actual Prompt Memory Tokens",
      "type": "integer"
    },
    "answer_id": {
      "format": "uuid",
      "title": "Answer Id",
      "type": "string"
    },
    "applied_control_count": {
      "maximum": 8,
      "minimum": 0,
      "title": "Applied Control Count",
      "type": "integer"
    },
    "applied_control_set_sha256": {
      "title": "Applied Control Set Sha256",
      "type": "string"
    },
    "assembly_context_sha256": {
      "title": "Assembly Context Sha256",
      "type": "string"
    },
    "assembly_input_sha256": {
      "title": "Assembly Input Sha256",
      "type": "string"
    },
    "binding_manifest_sha256": {
      "title": "Binding Manifest Sha256",
      "type": "string"
    },
    "contract_version": {
      "const": "final_answer_memory_binding_v1",
      "title": "Contract Version",
      "type": "string"
    },
    "control_items": {
      "items": {
        "$ref": "#/$defs/MemoryAnswerControlBindingItemV1"
      },
      "title": "Control Items",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "envelope_contract_version": {
      "const": "memory_selection_envelope_v1",
      "title": "Envelope Contract Version",
      "type": "string"
    },
    "envelope_sha256": {
      "title": "Envelope Sha256",
      "type": "string"
    },
    "exposed_count": {
      "maximum": 8,
      "minimum": 0,
      "title": "Exposed Count",
      "type": "integer"
    },
    "exposed_set_sha256": {
      "title": "Exposed Set Sha256",
      "type": "string"
    },
    "injected_count": {
      "maximum": 8,
      "minimum": 0,
      "title": "Injected Count",
      "type": "integer"
    },
    "injected_set_sha256": {
      "title": "Injected Set Sha256",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/MemoryAnswerBindingItemV1"
      },
      "title": "Items",
      "type": "array"
    },
    "max_memory_prompt_tokens": {
      "maximum": 1200,
      "minimum": 0,
      "title": "Max Memory Prompt Tokens",
      "type": "integer"
    },
    "outcome": {
      "enum": [
        "no_memory_selected",
        "selected_not_injected",
        "injected_not_exposed",
        "exposed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "owner_user_id": {
      "format": "uuid",
      "title": "Owner User Id",
      "type": "string"
    },
    "renderer_version": {
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/+\\-]{0,159}$",
      "title": "Renderer Version",
      "type": "string"
    },
    "request_binding_sha256": {
      "title": "Request Binding Sha256",
      "type": "string"
    },
    "request_id_sha256": {
      "title": "Request Id Sha256",
      "type": "string"
    },
    "selected_control_count": {
      "maximum": 8,
      "minimum": 0,
      "title": "Selected Control Count",
      "type": "integer"
    },
    "selected_control_set_sha256": {
      "title": "Selected Control Set Sha256",
      "type": "string"
    },
    "selected_count": {
      "maximum": 8,
      "minimum": 0,
      "title": "Selected Count",
      "type": "integer"
    },
    "selection_set_sha256": {
      "title": "Selection Set Sha256",
      "type": "string"
    },
    "selection_trace_id": {
      "format": "uuid",
      "title": "Selection Trace Id",
      "type": "string"
    },
    "thread_id_sha256": {
      "title": "Thread Id Sha256",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "envelope_contract_version",
    "owner_user_id",
    "answer_id",
    "selection_trace_id",
    "envelope_sha256",
    "request_binding_sha256",
    "assembly_context_sha256",
    "assembly_input_sha256",
    "renderer_version",
    "max_memory_prompt_tokens",
    "request_id_sha256",
    "thread_id_sha256",
    "selection_set_sha256",
    "injected_set_sha256",
    "exposed_set_sha256",
    "selected_control_set_sha256",
    "applied_control_set_sha256",
    "selected_count",
    "injected_count",
    "exposed_count",
    "selected_control_count",
    "applied_control_count",
    "actual_prompt_memory_tokens",
    "outcome",
    "items",
    "control_items",
    "created_at",
    "binding_manifest_sha256"
  ],
  "title": "FinalAnswerMemoryBindingV1",
  "type": "object"
}
