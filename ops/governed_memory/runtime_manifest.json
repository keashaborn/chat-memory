{
  "schema_version": "governed-memory-runtime-manifest-v2",
  "phase": "candidate_uninstalled",
  "python_runtime": {
    "minimum": "3.11",
    "validated_candidate": "3.12"
  },
  "authority": {
    "database": "governed_memory",
    "conversation_bridge": "public.memory_ingest_outbox",
    "qdrant_alias": "governed_memory_active"
  },
  "activation": {
    "installed_services": [],
    "enabled_services": [],
    "installed_timers": [],
    "enabled_timers": [],
    "future_target_service": "governed-memory-worker.service",
    "production_authorized": false,
    "blockers": [
      "semantic_score_threshold_not_calibrated",
      "supabase_to_database_owner_context_not_integration_tested",
      "service_http_routes_not_installed_or_invoked",
      "real_provider_and_embedding_adapters_not_exercised"
    ]
  },
  "ingestion": {
    "historical_import": false,
    "historical_backfill": false,
    "attachment_content_release_1": false,
    "requires_post_cutover_message": true
  },
  "provider_policy": {
    "import_time_calls": false,
    "production_calls_authorized": false,
    "disposable_phase_2_external_calls": 0,
    "generation_calls_per_exact_attempt": 1
  },
  "disposable_validation": {
    "scope": "phase_2_disposable_only",
    "validation_document": "docs/memory/clean_successor/PHASE2_VALIDATION.md",
    "runner_receipt": "stdout:PHASE2_DISPOSABLE_RECEIPT",
    "postgresql_fresh_empty": true,
    "qdrant_fresh_empty": true,
    "migration_forward_rollback_reapply": true,
    "normalized_catalog_equivalent_after_reapply": true,
    "forced_rls_owner_isolation_and_direct_dml_denial": true,
    "distinct_chat_a_chat_b": true,
    "cold_extraction_reconstruction": true,
    "cold_postgresql_projection_rebuild": true,
    "correction_retraction_hard_delete_and_retention": true,
    "production_data_read": false,
    "provider_external_calls": 0,
    "final_resources_absent": true
  },
  "owner_routes": [
    "GET /memory/status",
    "GET /memory/claims",
    "GET /memory/claims/{claim_id}",
    "GET /memory/proposals",
    "POST /memory/proposals/{proposal_id}/review",
    "POST /memory/claims/{claim_id}/correct",
    "POST /memory/claims/{claim_id}/retract",
    "DELETE /memory/claims/{claim_id}",
    "GET /memory/operations/{operation_id}"
  ],
  "prohibited_routes": [
    "/cards",
    "/vantage",
    "/memory/evidence",
    "/memory/retrieve"
  ],
  "legacy_imports_allowed": false,
  "production_state_changed": false
}
