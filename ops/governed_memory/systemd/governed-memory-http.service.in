# Candidate template only. It is not installed, enabled, started, or activated.
# There is intentionally no install section. The worker template is separate
# and equally dormant; neither template is installed or enabled.
[Unit]
Description=Governed Memory clean successor HTTP candidate
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/governed-memory/http.env

[Service]
Type=simple
User=governed-memory
Group=governed-memory
Environment=GOVERNED_MEMORY_HTTP_MODE=off
EnvironmentFile=/etc/governed-memory/http.env
ExecStart=/opt/governed-memory/current/venv/bin/governed-memory-http
Restart=no
TimeoutStartSec=30
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SocketBindDeny=any
SocketBindAllow=tcp:8091
StandardOutput=journal
StandardError=journal
SyslogIdentifier=governed-memory-http
