[Unit]
Description=Governed Memory clean successor HTTP service
After=network-online.target governed-memory-postgres-loopback.socket
Wants=network-online.target governed-memory-postgres-loopback.socket
ConditionPathExists=/etc/governed-memory/runtime/http.env

[Service]
Type=simple
User=governed-memory
Group=governed-memory-proxy
RuntimeDirectory=governed-memory
RuntimeDirectoryMode=0750
EnvironmentFile=/etc/governed-memory/runtime/http.env
ExecStart=/opt/governed-memory/current/venv/bin/governed-memory-http
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0007
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=governed-memory-http

[Install]
WantedBy=multi-user.target
