{
  "$id": "https://lifeswitch.local/schemas/governed-memory/recovery-proof-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_client_count": {
      "const": 0
    },
    "authorization_namespace": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "authorization_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "execution_id": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "exact_target_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "journal_head_after_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "journal_head_before_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "journal_sequence_after": {
      "minimum": 0,
      "type": "integer"
    },
    "journal_sequence_before": {
      "minimum": 0,
      "type": "integer"
    },
    "legacy_import_count": {
      "const": 0
    },
    "observed_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "exact_resume_complete",
        "exact_rollback_complete",
        "refused_on_drift"
      ]
    },
    "pilot_ever_started": {
      "const": false
    },
    "postgresql_user_row_count": {
      "const": 0
    },
    "postgresql_projection_queue_row_count": {
      "const": 0
    },
    "proof_type": {
      "const": "phase8b_recovery_evidence_not_authority"
    },
    "qdrant_point_count": {
      "const": 0
    },
    "recovery_action": {
      "enum": [
        "refuse",
        "resume",
        "rollback"
      ]
    },
    "schema_version": {
      "const": "governed-memory-installation-recovery-proof-v1"
    },
    "scope_id": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "scope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_postgres_connection_count": {
      "const": 0
    },
    "thread_id": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "proof_type",
    "execution_id",
    "authorization_namespace",
    "thread_id",
    "scope_id",
    "scope_sha256",
    "authorization_sha256",
    "journal_head_before_sha256",
    "journal_head_after_sha256",
    "journal_sequence_before",
    "journal_sequence_after",
    "exact_target_state_sha256",
    "recovery_action",
    "outcome",
    "observed_at",
    "pilot_ever_started",
    "postgresql_user_row_count",
    "postgresql_projection_queue_row_count",
    "qdrant_point_count",
    "active_client_count",
    "legacy_import_count",
    "source_postgres_connection_count"
  ],
  "title": "Governed Memory Phase 8B recovery evidence",
  "type": "object"
}
