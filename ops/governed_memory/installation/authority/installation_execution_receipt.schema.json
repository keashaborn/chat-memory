{
  "$id": "https://lifeswitch.local/schemas/governed-memory/installation-execution-receipt-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_namespace": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "authorization_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "candidate_git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "candidate_git_tree": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "controller_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "exact_targets_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "execution_id": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "execution_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "journal_head_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "journal_sequence": {
      "minimum": 0,
      "type": "integer"
    },
    "outcome": {
      "const": "dormant_install_complete"
    },
    "package_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "postflight_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "preflight_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "provider_call_count": {
      "const": 0
    },
    "receipt_type": {
      "const": "phase8b_dormant_install_execution_evidence_not_authority"
    },
    "schema_version": {
      "const": "governed-memory-installation-execution-receipt-v1"
    },
    "scope_id": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "scope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_postgres_connection_count": {
      "const": 0
    },
    "started_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "state_changed": {
      "const": true
    },
    "thread_id": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "trust_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "receipt_type",
    "execution_id",
    "authorization_namespace",
    "thread_id",
    "scope_id",
    "scope_sha256",
    "authorization_sha256",
    "trust_bundle_sha256",
    "candidate_git_commit",
    "candidate_git_tree",
    "package_manifest_sha256",
    "controller_contract_sha256",
    "execution_plan_sha256",
    "exact_targets_sha256",
    "journal_head_sha256",
    "journal_sequence",
    "preflight_receipt_sha256",
    "postflight_receipt_sha256",
    "started_at",
    "completed_at",
    "source_postgres_connection_count",
    "provider_call_count",
    "state_changed",
    "outcome"
  ],
  "title": "Governed Memory Phase 8B dormant-install execution evidence",
  "type": "object"
}
