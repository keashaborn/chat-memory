{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:governed-memory:empty-store-rollback-receipt:v4",
  "title": "Governed Memory empty store rollback receipt v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "result",
    "execution_id",
    "attempt_id",
    "candidate_git_commit",
    "candidate_git_tree",
    "package_manifest_sha256",
    "controller_runtime_receipt_sha256",
    "controller_runtime_root",
    "controller_runtime_tree_sha256",
    "controller_release_root",
    "controller_release_tree_sha256",
    "controller_release_package_manifest_path",
    "controller_runtime_interpreter_path",
    "controller_runtime_interpreter_sha256",
    "controller_runtime_inventory_path",
    "controller_runtime_inventory_sha256",
    "controller_requirements_lock_sha256",
    "supervisor_launcher_path",
    "supervisor_launcher_sha256",
    "installation_receipt_sha256",
    "authorization_sha256",
    "plan_sha256",
    "journal_head_sha256",
    "journal_sequence",
    "resource_ledger_head_sha256",
    "resource_ledger_sequence",
    "eligibility_receipt_sha256",
    "retained_audit_set_sha256",
    "exact_rollback_resources_absent_count",
    "exact_resources_absent",
    "stores_installed",
    "stores_supervisor_installed",
    "source_postgres_read_count",
    "source_postgres_write_count",
    "production_data_read",
    "provider_calls",
    "application_services_installed",
    "activation_performed",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "governed-memory-empty-store-rollback-receipt-v4"},
    "operation": {"const": "empty_store_rollback"},
    "result": {"const": "empty_store_rollback_complete"},
    "execution_id": {"$ref": "#/$defs/sha256"},
    "attempt_id": {"type": "string", "pattern": "^rollback-[0-9a-f]{40}$"},
    "candidate_git_commit": {"$ref": "#/$defs/git40"},
    "candidate_git_tree": {"$ref": "#/$defs/git40"},
    "package_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "controller_runtime_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "controller_runtime_root": {"type": "string", "pattern": "^/opt/governed-memory-controller/runtimes/[0-9a-f]{64}$"},
    "controller_runtime_tree_sha256": {"$ref": "#/$defs/sha256"},
    "controller_release_root": {"type": "string", "pattern": "^/opt/governed-memory-controller/releases/[0-9a-f]{64}$"},
    "controller_release_tree_sha256": {"$ref": "#/$defs/sha256"},
    "controller_release_package_manifest_path": {"type": "string", "pattern": "^/opt/governed-memory-controller/releases/[0-9a-f]{64}/ops/governed_memory/installation/current/package_manifest\\.json$"},
    "controller_runtime_interpreter_path": {"type": "string", "pattern": "^/opt/governed-memory-controller/runtimes/[0-9a-f]{64}/bin/python$"},
    "controller_runtime_interpreter_sha256": {"$ref": "#/$defs/sha256"},
    "controller_runtime_inventory_path": {"type": "string", "pattern": "^/opt/governed-memory-controller/runtimes/[0-9a-f]{64}/controller-distributions\\.json$"},
    "controller_runtime_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "controller_requirements_lock_sha256": {"$ref": "#/$defs/sha256"},
    "supervisor_launcher_path": {"type": "string", "pattern": "^/opt/governed-memory-controller/releases/[0-9a-f]{64}/tools/governed_memory_install/store_supervisor_launcher\\.py$"},
    "supervisor_launcher_sha256": {"$ref": "#/$defs/sha256"},
    "installation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "journal_head_sha256": {"$ref": "#/$defs/sha256"},
    "journal_sequence": {"type": "integer", "minimum": 1},
    "resource_ledger_head_sha256": {"$ref": "#/$defs/sha256"},
    "resource_ledger_sequence": {"type": "integer", "minimum": 1},
    "eligibility_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "retained_audit_set_sha256": {"$ref": "#/$defs/sha256"},
    "exact_rollback_resources_absent_count": {"const": 15},
    "exact_resources_absent": {"const": true},
    "stores_installed": {"const": false},
    "stores_supervisor_installed": {"const": false},
    "source_postgres_read_count": {"const": 0},
    "source_postgres_write_count": {"const": 0},
    "production_data_read": {"const": false},
    "provider_calls": {"const": 0},
    "application_services_installed": {"const": false},
    "activation_performed": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git40": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
