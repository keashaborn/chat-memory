{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeswitch.local/schemas/governed-memory-installation-journal-entry-v1.json",
  "title": "Governed Memory Phase 8A content-free controller journal entry",
  "$comment": "Shape validation is not execution authority. Hash-chain, sequence, binding, filesystem, and event-order validation are enforced by tools/governed_memory_install/journal.py and controller.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_sha256",
    "sequence",
    "operation",
    "attempt_id",
    "step_id",
    "event",
    "disposable_authorization_sha256",
    "prior_entry_sha256",
    "entry_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "governed-memory-installation-journal-entry-v1"
    },
    "binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "operation": {
      "enum": ["install", "rollback", "compensation"]
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "step_id": {
      "type": "string",
      "pattern": "^[IR][0-9]{2}_[A-Z0-9_]+$"
    },
    "event": {
      "enum": ["intent", "effect_complete", "recovered_after_effect"]
    },
    "disposable_authorization_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prior_entry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
