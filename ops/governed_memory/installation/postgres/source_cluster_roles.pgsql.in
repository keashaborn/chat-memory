-- TEMPLATE ONLY. Narrowly additive role bootstrap for the EXISTING production
-- conversation cluster. It reads catalog metadata only, creates four exact
-- roles when all four are absent, accepts the exact retained inactive set after
-- an empty-only bridge rollback, fails on every partial/drifted set, and grants
-- no runtime membership.
-- The conversation bridge migration and each membership activation remain
-- separate authorization checkpoints. API and worker roles are deliberately
-- NOLOGIN; credential and LOGIN activation is a later approved operation.
\set ON_ERROR_STOP on

BEGIN;

DO $catalog_preflight$
DECLARE
  relation_name text;
  runtime_role_count integer;
BEGIN
  IF current_database() <> 'memory' OR current_user <> 'sage' THEN
    RAISE EXCEPTION 'source role bootstrap requires memory as sage';
  END IF;
  IF pg_catalog.current_setting('server_encoding') <> 'UTF8' THEN
    RAISE EXCEPTION 'source database encoding differs';
  END IF;
  SELECT pg_catalog.count(*)::integer INTO runtime_role_count
  FROM pg_catalog.pg_roles
  WHERE rolname IN (
      'governed_memory_api',
      'governed_memory_worker',
      'memory_ingest_writer',
      'memory_erasure_requester'
  );
  IF runtime_role_count NOT IN (0, 4) THEN
    RAISE EXCEPTION 'source runtime role set is partial';
  END IF;
  IF runtime_role_count = 4 AND EXISTS (
    SELECT 1
    FROM pg_catalog.pg_roles
    WHERE rolname IN (
      'governed_memory_api',
      'governed_memory_worker',
      'memory_ingest_writer',
      'memory_erasure_requester'
    ) AND (
      rolcanlogin OR rolinherit OR rolsuper OR rolcreatedb OR rolcreaterole
      OR rolreplication OR rolbypassrls
    )
  ) THEN
    RAISE EXCEPTION 'retained source runtime role set differs';
  END IF;
  IF EXISTS (
    SELECT 1
    FROM pg_catalog.pg_auth_members AS membership
    JOIN pg_catalog.pg_roles AS granted_role
      ON granted_role.oid = membership.roleid
    JOIN pg_catalog.pg_roles AS member_role
      ON member_role.oid = membership.member
    WHERE granted_role.rolname IN (
      'governed_memory_api',
      'governed_memory_worker',
      'memory_ingest_writer',
      'memory_erasure_requester'
    ) OR member_role.rolname IN (
      'governed_memory_api',
      'governed_memory_worker',
      'memory_ingest_writer',
      'memory_erasure_requester'
    )
  ) THEN
    RAISE EXCEPTION 'source runtime membership graph must be empty';
  END IF;
  IF NOT EXISTS (
    SELECT 1 FROM pg_catalog.pg_roles
    WHERE rolname = 'brains_app'
      AND rolcanlogin AND rolinherit
      AND NOT rolsuper AND NOT rolcreatedb AND NOT rolcreaterole
      AND NOT rolreplication AND NOT rolbypassrls
  ) THEN
    RAISE EXCEPTION 'brains_app identity differs';
  END IF;
  FOREACH relation_name IN ARRAY ARRAY[
    'chat_log', 'threads', 'chat_attachments'
  ] LOOP
    IF NOT EXISTS (
      SELECT 1
      FROM pg_catalog.pg_class AS relation
      JOIN pg_catalog.pg_namespace AS namespace
        ON namespace.oid = relation.relnamespace
      WHERE namespace.nspname = 'public'
        AND relation.relname = relation_name
        AND relation.relkind = 'r'
        AND relation.relowner = 'sage'::regrole
        AND relation.relrowsecurity
        AND relation.relforcerowsecurity
    ) THEN
      RAISE EXCEPTION 'source relation % identity differs', relation_name;
    END IF;
  END LOOP;
  IF pg_catalog.to_regnamespace('memory_ingest_private') IS NOT NULL THEN
    RAISE EXCEPTION 'conversation bridge schema already exists';
  END IF;
  IF pg_catalog.current_setting('log_statement') <> 'none'
     OR pg_catalog.current_setting(
       'log_parameter_max_length_on_error'
     )::integer <> 0
     OR pg_catalog.current_setting('log_duration') <> 'off'
     OR pg_catalog.current_setting(
       'log_min_duration_statement'
     )::integer <> -1
     OR pg_catalog.current_setting(
       'log_min_duration_sample'
     )::integer <> -1
     OR pg_catalog.current_setting(
       'log_transaction_sample_rate'
     )::numeric <> 0
     OR pg_catalog.current_setting(
       'log_parameter_max_length'
     )::integer <> 0
     OR (
       pg_catalog.current_setting(
         'auto_explain.log_parameter_max_length', true
       ) IS NOT NULL
       AND pg_catalog.current_setting(
         'auto_explain.log_parameter_max_length', true
       )::integer <> 0
     )
     OR EXISTS (
       SELECT 1
       FROM pg_catalog.unnest(
         pg_catalog.string_to_array(
           pg_catalog.current_setting('shared_preload_libraries'), ','
         )
       ) AS configured(library_name)
       WHERE pg_catalog.lower(
         pg_catalog.btrim(configured.library_name)
       ) = 'pgaudit'
     ) THEN
    RAISE EXCEPTION 'source parameter logging preflight failed';
  END IF;
END;
$catalog_preflight$;

DO $create_roles_if_absent$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_catalog.pg_roles
    WHERE rolname IN (
      'governed_memory_api', 'governed_memory_worker',
      'memory_ingest_writer', 'memory_erasure_requester'
    )
  ) THEN
    CREATE ROLE memory_ingest_writer
      NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE
      NOREPLICATION NOBYPASSRLS;
    CREATE ROLE memory_erasure_requester
      NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE
      NOREPLICATION NOBYPASSRLS;
    CREATE ROLE governed_memory_api
      NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE
      NOREPLICATION NOBYPASSRLS;
    CREATE ROLE governed_memory_worker
      NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE
      NOREPLICATION NOBYPASSRLS;
  END IF;
END;
$create_roles_if_absent$;

DO $catalog_postflight$
DECLARE
  role_record record;
BEGIN
  FOR role_record IN
    SELECT role_name, must_login
    FROM (VALUES
      ('memory_ingest_writer'::text, false),
      ('memory_erasure_requester'::text, false),
      ('governed_memory_api'::text, false),
      ('governed_memory_worker'::text, false)
    ) AS expected(role_name, must_login)
  LOOP
    IF NOT EXISTS (
      SELECT 1 FROM pg_catalog.pg_roles AS role
      WHERE role.rolname = role_record.role_name
        AND role.rolcanlogin = role_record.must_login
        AND NOT role.rolinherit AND NOT role.rolsuper
        AND NOT role.rolcreatedb AND NOT role.rolcreaterole
        AND NOT role.rolreplication AND NOT role.rolbypassrls
    ) THEN
      RAISE EXCEPTION 'source runtime role % differs', role_record.role_name;
    END IF;
  END LOOP;
  IF NOT EXISTS (
    SELECT 1
    FROM pg_catalog.pg_roles
    WHERE rolname = 'brains_app'
      AND rolcanlogin AND rolinherit
      AND NOT rolsuper AND NOT rolcreatedb AND NOT rolcreaterole
      AND NOT rolreplication AND NOT rolbypassrls
  ) THEN
    RAISE EXCEPTION 'brains_app identity differs after role bootstrap';
  END IF;
  IF EXISTS (
    SELECT 1
    FROM pg_catalog.pg_auth_members AS membership
    JOIN pg_catalog.pg_roles AS granted_role
      ON granted_role.oid = membership.roleid
    JOIN pg_catalog.pg_roles AS member_role
      ON member_role.oid = membership.member
    WHERE granted_role.rolname IN (
      'governed_memory_api',
      'governed_memory_worker',
      'memory_ingest_writer',
      'memory_erasure_requester'
    ) OR member_role.rolname IN (
      'governed_memory_api',
      'governed_memory_worker',
      'memory_ingest_writer',
      'memory_erasure_requester'
    )
  ) THEN
    RAISE EXCEPTION 'source runtime membership graph must remain empty';
  END IF;
END;
$catalog_postflight$;

COMMIT;
