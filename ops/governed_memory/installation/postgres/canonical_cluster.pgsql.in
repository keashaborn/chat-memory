-- TEMPLATE ONLY. Fresh successor cluster bootstrap. Never run against the
-- existing conversation database or any cluster containing a target role or
-- the governed_memory database. API and worker roles are deliberately NOLOGIN;
-- credential and LOGIN activation is a later approved operation.
\set ON_ERROR_STOP on
SELECT
  current_database() = 'postgres'
  AND current_user = 'governed_memory_bootstrap'
  AND pg_catalog.current_setting('server_encoding') = 'UTF8'
  AND pg_catalog.current_setting('log_statement') = 'none'
  AND pg_catalog.current_setting('log_duration') = 'off'
  AND pg_catalog.current_setting('log_min_duration_statement')::integer = -1
  AND pg_catalog.current_setting('log_min_duration_sample')::integer = -1
  AND pg_catalog.current_setting('log_transaction_sample_rate')::numeric = 0
  AND pg_catalog.current_setting('log_parameter_max_length')::integer = 0
  AND pg_catalog.current_setting(
    'log_parameter_max_length_on_error'
  )::integer = 0
  AND (
    pg_catalog.current_setting(
      'auto_explain.log_parameter_max_length', true
    ) IS NULL
    OR pg_catalog.current_setting(
      'auto_explain.log_parameter_max_length', true
    )::integer = 0
  )
  AND NOT EXISTS (
    SELECT 1
    FROM pg_catalog.unnest(
      pg_catalog.string_to_array(
        pg_catalog.current_setting('shared_preload_libraries'), ','
      )
    ) AS configured(library_name)
    WHERE pg_catalog.lower(
      pg_catalog.btrim(configured.library_name)
    ) = 'pgaudit'
  )
  AND NOT EXISTS (
    SELECT 1 FROM pg_catalog.pg_database WHERE datname = 'governed_memory'
  )
  AND NOT EXISTS (
    SELECT 1
    FROM pg_catalog.pg_roles
    WHERE rolname IN (
      'governed_memory_owner',
      'governed_memory_api',
      'governed_memory_worker',
      'memory_ingest_writer',
      'memory_erasure_requester'
    )
  ) AS governed_memory_fresh_cluster
\gset
\if :governed_memory_fresh_cluster
\else
DO $governed_memory_refusal$
BEGIN
  RAISE EXCEPTION USING
    ERRCODE = 'P0001',
    MESSAGE = 'fresh successor cluster preflight failed';
END
$governed_memory_refusal$;
\endif

CREATE ROLE governed_memory_owner
  NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE governed_memory_api
  NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE governed_memory_worker
  NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE memory_ingest_writer
  NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE memory_erasure_requester
  NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;

CREATE DATABASE governed_memory
  OWNER governed_memory_owner
  ENCODING 'UTF8'
  TEMPLATE template0;
REVOKE ALL ON DATABASE governed_memory FROM PUBLIC;
GRANT CONNECT ON DATABASE governed_memory
  TO governed_memory_api, governed_memory_worker;
GRANT governed_memory_owner TO governed_memory_bootstrap;

\connect governed_memory
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
SET ROLE governed_memory_owner;
CREATE EXTENSION pgcrypto WITH SCHEMA public;
RESET ROLE;

SELECT
  current_database() = 'governed_memory'
  AND pg_catalog.current_setting('log_statement') = 'none'
  AND pg_catalog.current_setting('log_duration') = 'off'
  AND pg_catalog.current_setting('log_min_duration_statement')::integer = -1
  AND pg_catalog.current_setting('log_min_duration_sample')::integer = -1
  AND pg_catalog.current_setting('log_transaction_sample_rate')::numeric = 0
  AND pg_catalog.current_setting('log_parameter_max_length')::integer = 0
  AND pg_catalog.current_setting(
    'log_parameter_max_length_on_error'
  )::integer = 0
  AND pg_catalog.pg_get_userbyid(database.datdba) = 'governed_memory_owner'
  AND NOT EXISTS (
    SELECT 1
    FROM pg_catalog.aclexplode(
      COALESCE(
        database.datacl,
        pg_catalog.acldefault('d', database.datdba)
      )
    ) AS privilege
    WHERE privilege.grantee = 0
      AND privilege.privilege_type = 'CONNECT'
  )
  AND pg_catalog.has_database_privilege(
    'governed_memory_api', 'governed_memory', 'CONNECT'
  )
  AND pg_catalog.has_database_privilege(
    'governed_memory_worker', 'governed_memory', 'CONNECT'
  )
  AND NOT EXISTS (
    SELECT 1
    FROM pg_catalog.pg_namespace AS namespace
    CROSS JOIN LATERAL pg_catalog.aclexplode(
      COALESCE(
        namespace.nspacl,
        pg_catalog.acldefault('n', namespace.nspowner)
      )
    ) AS privilege
    WHERE namespace.nspname = 'public'
      AND privilege.grantee = 0
      AND privilege.privilege_type = 'CREATE'
  )
  AND EXISTS (
    SELECT 1
    FROM pg_catalog.pg_extension AS extension
    JOIN pg_catalog.pg_roles AS extension_owner
      ON extension_owner.oid = extension.extowner
    WHERE extension.extname = 'pgcrypto'
      AND extension.extversion = '1.3'
      AND extension_owner.rolname = 'governed_memory_owner'
  )
  AND (
    SELECT pg_catalog.count(*) = 36
      AND pg_catalog.bool_and(
        pg_catalog.pg_get_userbyid(procedure.proowner) =
          'governed_memory_bootstrap'
      )
    FROM pg_catalog.pg_depend AS dependency
    JOIN pg_catalog.pg_proc AS procedure
      ON dependency.classid = 'pg_catalog.pg_proc'::pg_catalog.regclass
      AND dependency.objid = procedure.oid
    WHERE dependency.refclassid =
      'pg_catalog.pg_extension'::pg_catalog.regclass
      AND dependency.refobjid = (
        SELECT extension.oid
        FROM pg_catalog.pg_extension AS extension
        WHERE extension.extname = 'pgcrypto'
      )
      AND dependency.deptype = 'e'
  )
  AND pg_catalog.to_regprocedure('public.digest(bytea,text)') IS NOT NULL
  AS governed_memory_bootstrap_verified
FROM pg_catalog.pg_database AS database
WHERE database.datname = current_database()
\gset
\if :governed_memory_bootstrap_verified
\else
DO $governed_memory_refusal$
BEGIN
  RAISE EXCEPTION USING
    ERRCODE = 'P0001',
    MESSAGE = 'fresh successor cluster postflight failed';
END
$governed_memory_refusal$;
\endif

DO $role_postflight$
DECLARE
  role_record record;
BEGIN
  FOR role_record IN
    SELECT role_name
    FROM (VALUES
      ('governed_memory_owner'::text),
      ('governed_memory_api'::text),
      ('governed_memory_worker'::text),
      ('memory_ingest_writer'::text),
      ('memory_erasure_requester'::text)
    ) AS expected(role_name)
  LOOP
    IF NOT EXISTS (
      SELECT 1
      FROM pg_catalog.pg_roles AS role
      WHERE role.rolname = role_record.role_name
        AND NOT role.rolcanlogin AND NOT role.rolinherit
        AND NOT role.rolsuper AND NOT role.rolcreatedb
        AND NOT role.rolcreaterole AND NOT role.rolreplication
        AND NOT role.rolbypassrls
    ) THEN
      RAISE EXCEPTION
        'canonical runtime role % differs after bootstrap',
        role_record.role_name;
    END IF;
  END LOOP;

  IF NOT EXISTS (
    SELECT 1
    FROM pg_catalog.pg_auth_members AS membership
    JOIN pg_catalog.pg_roles AS granted_role
      ON granted_role.oid = membership.roleid
    JOIN pg_catalog.pg_roles AS member_role
      ON member_role.oid = membership.member
    WHERE granted_role.rolname = 'governed_memory_owner'
      AND member_role.rolname = 'governed_memory_bootstrap'
  ) OR EXISTS (
    SELECT 1
    FROM pg_catalog.pg_auth_members AS membership
    JOIN pg_catalog.pg_roles AS granted_role
      ON granted_role.oid = membership.roleid
    JOIN pg_catalog.pg_roles AS member_role
      ON member_role.oid = membership.member
    WHERE (
      granted_role.rolname IN (
        'governed_memory_bootstrap',
        'governed_memory_owner',
        'governed_memory_api',
        'governed_memory_worker',
        'memory_ingest_writer',
        'memory_erasure_requester'
      )
      OR member_role.rolname IN (
        'governed_memory_bootstrap',
        'governed_memory_owner',
        'governed_memory_api',
        'governed_memory_worker',
        'memory_ingest_writer',
        'memory_erasure_requester'
      )
    ) AND NOT (
      granted_role.rolname = 'governed_memory_owner'
      AND member_role.rolname = 'governed_memory_bootstrap'
    )
  ) THEN
    RAISE EXCEPTION 'canonical inactive role membership graph differs';
  END IF;
END;
$role_postflight$;
