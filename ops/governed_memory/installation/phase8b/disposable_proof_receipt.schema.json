{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:governed-memory:phase8b:disposable-proof-receipt:v1",
  "title": "Governed Memory Phase 8B Disposable Synthetic Proof Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_scope",
    "outcome",
    "scenario_count",
    "plan_step_count",
    "compensable_step_count",
    "scenario_family_counts",
    "outcome_counts",
    "operation_counts",
    "journal_record_count",
    "scenario_matrix_sha256",
    "scenario_result_set_sha256",
    "journal_head_set_sha256",
    "state_result_set_sha256",
    "controller_plan_model_sha256",
    "controller_plan_document_sha256",
    "proof_contract_sha256",
    "receipt_schema_sha256",
    "proof_sources_sha256",
    "package_manifest_sha256",
    "guard",
    "claims",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "governed-memory-phase8b-disposable-proof-receipt-v1"
    },
    "proof_scope": {"const": "synthetic_in_process_model_only"},
    "outcome": {"const": "synthetic_matrix_passed"},
    "scenario_count": {"const": 131},
    "plan_step_count": {"const": 20},
    "compensable_step_count": {"const": 15},
    "scenario_family_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "happy_path",
        "ordinary_failure_before_effect",
        "ordinary_failure_after_effect",
        "interrupt_before_effect",
        "interrupt_after_effect",
        "interrupt_after_applied_journal",
        "interrupt_before_compensation",
        "interrupt_after_compensation"
      ],
      "properties": {
        "happy_path": {"const": 1},
        "ordinary_failure_before_effect": {"const": 20},
        "ordinary_failure_after_effect": {"const": 20},
        "interrupt_before_effect": {"const": 20},
        "interrupt_after_effect": {"const": 20},
        "interrupt_after_applied_journal": {"const": 20},
        "interrupt_before_compensation": {"const": 15},
        "interrupt_after_compensation": {"const": 15}
      }
    },
    "outcome_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inactive_complete",
        "same_attempt_compensated",
        "sealed_state_refused"
      ],
      "properties": {
        "inactive_complete": {"const": 59},
        "same_attempt_compensated": {"const": 69},
        "sealed_state_refused": {"const": 3}
      }
    },
    "operation_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apply",
        "compensate",
        "interruption",
        "journal_append",
        "ordinary_failure",
        "probe"
      ],
      "properties": {
        "apply": {"type": "integer", "minimum": 1},
        "compensate": {"type": "integer", "minimum": 1},
        "interruption": {"const": 90},
        "journal_append": {"type": "integer", "minimum": 1},
        "ordinary_failure": {"const": 70},
        "probe": {"type": "integer", "minimum": 1}
      }
    },
    "journal_record_count": {"type": "integer", "minimum": 1},
    "scenario_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "scenario_result_set_sha256": {"$ref": "#/$defs/sha256"},
    "journal_head_set_sha256": {"$ref": "#/$defs/sha256"},
    "state_result_set_sha256": {"$ref": "#/$defs/sha256"},
    "controller_plan_model_sha256": {"$ref": "#/$defs/sha256"},
    "controller_plan_document_sha256": {"$ref": "#/$defs/sha256"},
    "proof_contract_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_schema_sha256": {"$ref": "#/$defs/sha256"},
    "proof_sources_sha256": {"$ref": "#/$defs/sha256"},
    "package_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrumentation",
        "audit_hook_configured",
        "blocked_effect_count",
        "environment_access_count"
      ],
      "properties": {
        "instrumentation": {"const": "python_audit_hook_best_effort_not_kernel_confinement"},
        "audit_hook_configured": {"const": true},
        "blocked_effect_count": {"const": 0},
        "environment_access_count": {"const": 0}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic_atomic_step_plan_model_exercised",
        "single_interruption_resume_model_exercised",
        "same_attempt_compensation_sequence_model_exercised",
        "full_pre_attempt_state_restoration_proven",
        "empty_rollback_proven",
        "live_execution_proven",
        "live_installation_proven",
        "live_rollback_proven",
        "durable_process_crash_recovery_proven",
        "composite_crash_recovery_proven",
        "docker_compatibility_proven",
        "systemd_compatibility_proven",
        "external_store_readiness_proven",
        "activation_proven",
        "secrets_accessed",
        "images_staged_or_pulled",
        "kernel_confinement_proven",
        "hostile_same_process_replacement_resisted"
      ],
      "properties": {
        "synthetic_atomic_step_plan_model_exercised": {"const": true},
        "single_interruption_resume_model_exercised": {"const": true},
        "same_attempt_compensation_sequence_model_exercised": {"const": true},
        "full_pre_attempt_state_restoration_proven": {"const": false},
        "empty_rollback_proven": {"const": false},
        "live_execution_proven": {"const": false},
        "live_installation_proven": {"const": false},
        "live_rollback_proven": {"const": false},
        "durable_process_crash_recovery_proven": {"const": false},
        "composite_crash_recovery_proven": {"const": false},
        "docker_compatibility_proven": {"const": false},
        "systemd_compatibility_proven": {"const": false},
        "external_store_readiness_proven": {"const": false},
        "activation_proven": {"const": false},
        "secrets_accessed": {"const": false},
        "images_staged_or_pulled": {"const": false},
        "kernel_confinement_proven": {"const": false},
        "hostile_same_process_replacement_resisted": {"const": false}
      }
    },
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
