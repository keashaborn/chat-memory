{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeswitch.local/schemas/governed-memory-installation-receipt-v2.json",
  "title": "Governed Memory inactive installation decision receipt",
  "$comment": "This schema validates only the closed receipt shape. Exact stage-conditioned state values and transitive receipt-chain semantics are authoritative only in tools/governed_memory_install/inactive_installation.py. Schema validation alone is neither a structural decision nor authorization.",
  "x-stage-profile-authority": "tools/governed_memory_install/inactive_installation.py",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "decision",
    "refusal_codes",
    "blockers",
    "authorization_inferred",
    "candidate_git_commit",
    "candidate_git_tree",
    "package_manifest_sha256",
    "prior_decision_receipt_sha256",
    "receipt_chain",
    "observation_canonical_sha256",
    "exact_target_states",
    "exact_source_cluster_states",
    "exact_successor_store_states",
    "phase8b_migration_execution_contract",
    "fresh_store_counts",
    "pilot_ever_started",
    "evaluator_mutating_commands_executed",
    "evaluator_provider_calls",
    "evaluator_state_changed"
  ],
  "properties": {
    "schema_version": {
      "const": "governed-memory-installation-decision-receipt-v2"
    },
    "stage": {
      "enum": [
        "install_preflight",
        "install_postflight",
        "rollback_preflight",
        "rollback_postflight"
      ]
    },
    "decision": {
      "enum": ["structurally_valid_candidate_not_authorization", "refuse"]
    },
    "refusal_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    },
    "authorization_inferred": {"const": false},
    "candidate_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_git_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "package_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prior_decision_receipt_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "receipt_chain": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "receipt_sha256"],
        "properties": {
          "stage": {
            "enum": [
              "install_preflight",
              "install_postflight",
              "rollback_preflight"
            ]
          },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "observation_canonical_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "exact_target_states": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgres_container",
        "qdrant_container",
        "postgres_volume",
        "qdrant_volume",
        "network",
        "database",
        "collection",
        "alias",
        "install_root",
        "environment_root",
        "runtime_environment_root",
        "state_root",
        "legacy_secret_quarantine_path_template",
        "backup_root",
        "http_unit",
        "worker_unit",
        "store_supervisor_unit"
      ],
      "patternProperties": {
        "^[a-z][a-z0-9_]+$": {"type": "string"}
      }
    },
    "exact_source_cluster_states": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_count",
        "catalog_read_count",
        "application_row_read_count",
        "write_count",
        "preparation_phase"
      ],
      "properties": {
        "connection_count": {"const": 0},
        "catalog_read_count": {"const": 0},
        "application_row_read_count": {"const": 0},
        "write_count": {"const": 0},
        "preparation_phase": {"const": "8C_separate_authorization_required"}
      }
    },
    "exact_successor_store_states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgresql", "qdrant"],
      "properties": {
        "postgresql": {"type": "string"},
        "qdrant": {"type": "string"}
      }
    },
    "phase8b_migration_execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "psql_variable_name",
        "psql_variable_value",
        "canonical_roles_preflight_requires_variable",
        "canonical_migrations",
        "source_postgresql_steps",
        "source_conversation_bridge_included",
        "omission_defaults_to_active_mode_and_invalidates_inactive_installation",
        "evaluator_verifies_execution"
      ],
      "properties": {
        "psql_variable_name": {
          "const": "governed_memory_inactive_installation"
        },
        "psql_variable_value": {"const": "on"},
        "canonical_roles_preflight_requires_variable": {"const": true},
        "canonical_migrations": {
          "const": [
            "governed_memory_foundation_0001",
            "governed_memory_owner_claim_detail_0003",
            "governed_memory_pilot_marker_0004"
          ]
        },
        "source_postgresql_steps": {"const": []},
        "source_conversation_bridge_included": {"const": false},
        "omission_defaults_to_active_mode_and_invalidates_inactive_installation": {
          "const": true
        },
        "evaluator_verifies_execution": {"const": false}
      }
    },
    "fresh_store_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successor_user_memory_row_count",
        "successor_projection_queue_row_count",
        "qdrant_point_count",
        "active_client_count",
        "legacy_import_count",
        "source_application_row_read_count"
      ],
      "properties": {
        "successor_user_memory_row_count": {"const": 0},
        "successor_projection_queue_row_count": {"const": 0},
        "qdrant_point_count": {"const": 0},
        "active_client_count": {"const": 0},
        "legacy_import_count": {"const": 0},
        "source_application_row_read_count": {"const": 0}
      }
    },
    "pilot_ever_started": {"const": false},
    "evaluator_mutating_commands_executed": {"const": 0},
    "evaluator_provider_calls": {"const": 0},
    "evaluator_state_changed": {"const": false}
  }
}
