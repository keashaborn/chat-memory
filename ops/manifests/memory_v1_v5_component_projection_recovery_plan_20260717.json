{
  "contract_version": "memory_v1_v5_component_projection_recovery_plan_v1",
  "plan_id": "memory-v1-v5-component-projection-recovery-20260717",
  "created_on": "2026-07-17",
  "production_authorized": false,
  "target": {
    "server": "seebx",
    "postgres_container": "brains-postgres-1",
    "database": "memory",
    "maintenance_role": "sage"
  },
  "recovery_boundaries": {
    "automatic_schema_rollback": false,
    "automatic_database_restore": false,
    "separate_live_restore_authorization_required": true,
    "runtime_must_remain_inactive": true,
    "component_registration_must_remain_disabled": true,
    "retrieval_activation_must_remain_disabled": true
  },
  "normal_failure_response": [
    "restore_exact_preinstall_timer_state",
    "preserve_status_preflight_backup_catalog_checksums_and_logs",
    "leave_component_registration_and_retrieval_inactive",
    "diagnose_before_retry",
    "rerun_only_after_hash_locked_plan_verification"
  ],
  "logical_component_rollback": {
    "path": "ops/sql/20260717_memory_v1_v5_project_components_rollback.sql",
    "sha256": "3cfd885638b59ac92aee1540749b7c0db8bfd73f0f3e019f632d45fffd8e1f01",
    "allowed_only_when": [
      "all_three_component_tables_are_empty",
      "no_projection_row_has_non_null_component_key",
      "no_component_registration_or_retrieval_has_been_activated"
    ],
    "scope": "removes_component_registry_tables_functions_and_foreign_keys_only",
    "not_a_full_schema_restore": true
  },
  "full_database_recovery": {
    "source": "fresh_custom_format_backup_created_by_the_install_runner",
    "required_checks": [
      "backup_file_nonempty",
      "backup_sha256_matches",
      "pg_restore_catalog_nonempty",
      "restore_rehearsed_into_a_replacement_database",
      "replacement_database_security_and_row_signatures_pass"
    ],
    "live_cutover_requires": [
      "separate_explicit_authorization",
      "maintenance_window",
      "all_memory_writers_quiesced",
      "fresh_pre_restore_backup",
      "documented_cutover_and_reversal_steps"
    ],
    "forbidden": [
      "unattended_pg_restore_clean_against_live_database",
      "restore_without_catalog_and_checksum_verification",
      "restore_while_memory_writers_are_active"
    ]
  },
  "hard_stop": "before_component_registration_retrieval_activation_or_prompt_influence"
}
