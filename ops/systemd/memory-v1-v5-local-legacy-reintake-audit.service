[Unit]
Description=Memory V1 read-only legacy reintake completion audit
After=network-online.target brains.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/chat-memory
EnvironmentFile=/opt/chat-memory/.env
Environment=PYTHONPATH=/opt/chat-memory
StateDirectory=memory-v1-v5-legacy-reintake-audit
StateDirectoryMode=0700
ExecStart=/opt/chat-memory/venv/bin/python /opt/chat-memory/scripts/memory_v1_v5_legacy_reintake_completion.py --owner-user-id 557ea042-cb82-48f8-9429-472e96c957ef --isolation-owner-user-id d839b4bc-0bd2-4f2d-aafe-0f3f75883db8 --selector-version 20260719_v5_legacy_claim_reintake_v1 --expected-jobs 5 --baseline /etc/memory-v1-local-inference/legacy-reintake-baseline.json --output /var/lib/memory-v1-v5-legacy-reintake-audit/completion-20260720T060000Z.json
SuccessExitStatus=2
TimeoutStartSec=2min
UMask=0077
Nice=10
CPUQuota=10%
MemoryMax=256M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
