[Unit]
Description=Memory V1 bounded owner-scoped private observation entailment
After=network-online.target brains.service memory-v1-v5-local-inference-tunnel.service memory-v1-v5-local-auto-resolution.service
Wants=network-online.target
Requires=memory-v1-v5-local-inference-tunnel.service
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/chat-memory
EnvironmentFile=/opt/chat-memory/.env
Environment=PYTHONPATH=/opt/chat-memory
Environment=MEMORY_V1_V5_LOCAL_ENTAILMENT_APPLY=memory_v1_v5_local_entailment_apply_v1
LoadCredential=local_api_key:/etc/memory-v1-local-inference/api-key
RuntimeDirectory=memory-v1-v5-local-entailment
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock -n /run/memory-v1-v5-local-entailment/worker.lock /opt/chat-memory/venv/bin/python /opt/chat-memory/scripts/memory_v1_v5_local_entailment_scheduler.py --max-records 10 --max-output-tokens 128 --timeout-seconds 120 --apply
TimeoutStartSec=25min
UMask=0077
Nice=10
CPUQuota=25%
MemoryMax=384M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
