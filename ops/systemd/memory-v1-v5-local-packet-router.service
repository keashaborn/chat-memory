[Unit]
Description=Memory V1 owner-scoped local packet router
After=network-online.target brains.service memory-v1-v5-local-inference-scheduler.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/chat-memory
EnvironmentFile=/opt/chat-memory/.env
Environment=PYTHONPATH=/opt/chat-memory
Environment=MEMORY_V1_V5_LOCAL_PACKET_ROUTER_APPLY=memory_v1_v5_local_packet_router_apply_v1
RuntimeDirectory=memory-v1-v5-local-packet-router
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock -n /run/memory-v1-v5-local-packet-router/worker.lock /opt/chat-memory/venv/bin/python /opt/chat-memory/scripts/memory_v1_v5_local_packet_router.py --owner-user-id 1240822d-ac9a-4096-95aa-e2b24d36ef50 --owner-user-id 557ea042-cb82-48f8-9429-472e96c957ef --owner-user-id d839b4bc-0bd2-4f2d-aafe-0f3f75883db8 --apply
TimeoutStartSec=5min
UMask=0077
Nice=10
CPUQuota=20%
MemoryMax=512M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/memory-v1-reviews
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
