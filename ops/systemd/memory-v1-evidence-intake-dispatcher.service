[Unit]
Description=Memory V1 authenticated-owner no-model evidence intake dispatcher
After=network-online.target brains.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/chat-memory
EnvironmentFile=/opt/chat-memory/.env
Environment=PYTHONPATH=/opt/chat-memory
ExecStart=/opt/chat-memory/venv/bin/python /opt/chat-memory/scripts/memory_v1_evidence_intake_dispatcher.py --selector-version 20260717_v2 --limit 100 --apply --report-path /tmp/memory-v1-evidence-intake-dispatcher.json
TimeoutStartSec=2min
UMask=0077
Nice=10
CPUQuota=25%
MemoryMax=512M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
