[Unit]
Description=Memory V1 six-owner no-model evidence intake dispatcher
After=network-online.target brains.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/chat-memory
EnvironmentFile=/opt/chat-memory/.env
Environment=PYTHONPATH=/opt/chat-memory
ExecStart=/opt/chat-memory/venv/bin/python /opt/chat-memory/scripts/memory_v1_evidence_intake_dispatcher.py --owner-user-id 1240822d-ac9a-4096-95aa-e2b24d36ef50 --owner-user-id 557ea042-cb82-48f8-9429-472e96c957ef --owner-user-id d839b4bc-0bd2-4f2d-aafe-0f3f75883db8 --owner-user-id 818b60b9-89bd-442a-998c-fc1924184dfc --owner-user-id 5c9f624a-a66d-4183-babb-b3a0f0f4e733 --owner-user-id 673d64a3-c4ba-4d1c-89e3-e0c579022fad --selector-version 20260716_v1 --limit 100 --apply --report-path /tmp/memory-v1-evidence-intake-dispatcher.json
TimeoutStartSec=2min
UMask=0077
Nice=10
CPUQuota=25%
MemoryMax=512M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
