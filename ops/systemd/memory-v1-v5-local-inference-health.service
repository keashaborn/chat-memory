[Unit]
Description=Memory V1 private local inference model health
After=network-online.target memory-v1-v5-local-inference-tunnel.service
Wants=network-online.target
Requires=memory-v1-v5-local-inference-tunnel.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/chat-memory
Environment=PYTHONPATH=/opt/chat-memory
LoadCredential=local_api_key:/etc/memory-v1-local-inference/api-key
ExecStart=/opt/chat-memory/venv/bin/python /opt/chat-memory/scripts/memory_v1_v5_local_inference_health.py
TimeoutStartSec=30s
UMask=0077
Nice=10
CPUQuota=5%
MemoryMax=128M
TasksMax=16
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
