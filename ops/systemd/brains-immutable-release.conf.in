# Render with scripts/render_release_unit.py and install as
# /etc/systemd/system/brains.service.d/zz-immutable-release.conf.
[Service]
WorkingDirectory=/opt/lifeswitch/releases/@COMMIT@
Environment=PYTHONDONTWRITEBYTECODE=1
# Canonical Zep settings are approval-bound values rendered by Work Runner.
UnsetEnvironment=QDRANT_URL ZEP_SHADOW_MODE ZEP_SHADOW_OWNER_IDS ZEP_SHADOW_TIMEOUT_SECONDS
Environment=ZEP_SYNC_MODE=@ZEP_SYNC_MODE@
Environment=ZEP_SYNC_OWNER_IDS=@ZEP_SYNC_OWNER_IDS@
Environment=ZEP_TIMEOUT_SECONDS=@ZEP_TIMEOUT_SECONDS@
Environment=ZEP_PROMPT_MODE=@ZEP_PROMPT_MODE@
Environment=ZEP_PROMPT_OWNER_IDS=@ZEP_PROMPT_OWNER_IDS@
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
ExecStart=
ExecStart=/opt/lifeswitch/runtimes/@COMMIT@/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8088 --app-dir /opt/lifeswitch/releases/@COMMIT@
ExecStartPre=
ExecStartPre=/opt/lifeswitch/runtimes/@COMMIT@/venv/bin/python /opt/lifeswitch/releases/@COMMIT@/scripts/verify_runtime_dependencies.py --pyproject /opt/lifeswitch/releases/@COMMIT@/pyproject.toml
