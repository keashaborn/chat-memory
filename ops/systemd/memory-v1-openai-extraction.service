[Unit]
Description=Memory V1 governed OpenAI personal-evidence extraction
After=network-online.target brains.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/chat-memory
EnvironmentFile=/opt/chat-memory/.env
EnvironmentFile=/etc/chat-memory/memory-openai-extraction.env
Environment=PYTHONPATH=/opt/chat-memory
Environment=MEMORY_V1_OPENAI_EXTRACTION_APPLY=memory_v1_openai_extraction_apply_v1
Environment=MEMORY_V1_OPENAI_STRUCTURED_CALLS=memory_v1_openai_structured_calls_v1
RuntimeDirectory=memory-v1-openai-extraction
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock -n /run/memory-v1-openai-extraction/worker.lock /opt/chat-memory/venv/bin/python /opt/chat-memory/scripts/memory_v1_openai_extraction_worker_v1.py --owner-user-id ${MEMORY_V1_OPENAI_OWNER_ALLOWLIST} --run-id ${MEMORY_V1_OPENAI_RUN_ID} --job-id ${MEMORY_V1_OPENAI_JOB_ID} --expected-content-sha256 ${MEMORY_V1_OPENAI_EXPECTED_CONTENT_SHA256} --model ${MEMORY_V1_OPENAI_MODEL} --sdk-version ${MEMORY_V1_OPENAI_SDK_VERSION} --max-jobs 1 --max-attempts 1 --lease-seconds 300 --timeout-seconds 120 --max-output-tokens 4096 --rolling-window-seconds 86400 --max-reserved-calls 12 --failure-threshold 3 --apply
TimeoutStartSec=4min
UMask=0077
Nice=10
CPUQuota=25%
MemoryMax=768M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
