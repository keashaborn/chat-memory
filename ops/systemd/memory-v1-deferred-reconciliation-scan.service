[Unit]
Description=Memory V1 deferred reconciliation report-only scanner
After=network-online.target brains.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/chat-memory
EnvironmentFile=/opt/chat-memory/.env
Environment=PYTHONPATH=/opt/chat-memory
Environment=MEMORY_V1_DEFERRED_SCANNER_OWNER_ROSTER=/opt/chat-memory/ops/config/memory_v1_deferred_scanner_owner_roster_v1.json
Environment=MEMORY_V1_DEFERRED_SCANNER_ROSTER_SHA256=c690823ff1a6311b76c52a6d47670a7741b6b8452b5729448a5a5c804fab100c
ExecStart=/opt/chat-memory/venv/bin/python /opt/chat-memory/scripts/memory_v1_deferred_reconciliation_scan_worker.py --limit 25
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
