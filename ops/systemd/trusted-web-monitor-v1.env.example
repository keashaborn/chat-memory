# Copy to /etc/verbalsage/trusted-web-monitor.env with mode 0600.
# POSTGRES_DSN remains owned by /opt/chat-memory/.env.
TRUSTED_WEB_MONITOR_ENABLED=authorized
TRUSTED_WEB_MONITOR_WINDOW_HOURS=24
TRUSTED_WEB_MONITOR_MAX_RELEVANCE_FAIL_CLOSED=0
TRUSTED_WEB_MONITOR_MAX_DEPENDENCY_FAILURES=0
TRUSTED_WEB_MONITOR_MAX_FAIL_CLOSED_RATE=0.25
# The private internal inbox is required and uses POSTGRES_DSN.
# Optional secondary HTTPS webhook; the internal inbox remains authoritative.
TRUSTED_WEB_MONITOR_ALERT_WEBHOOK_URL=
