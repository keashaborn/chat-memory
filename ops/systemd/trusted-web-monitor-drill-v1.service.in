[Unit]
Description=Run one authorized trusted-web alert delivery drill
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/lifeswitch/releases/@COMMIT@
EnvironmentFile=/opt/chat-memory/.env
EnvironmentFile=-/etc/verbalsage/trusted-web-monitor.env
Environment=PYTHONPATH=/opt/lifeswitch/releases/@COMMIT@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TRUSTED_WEB_MONITOR_DRILL_ENABLED=authorized
ExecStart=/usr/bin/flock -n /run/trusted-web-monitor-v1/drill.lock /opt/lifeswitch/runtimes/@COMMIT@/venv/bin/python /opt/lifeswitch/releases/@COMMIT@/scripts/trusted_web_monitor_job_v1.py --drill
RuntimeDirectory=trusted-web-monitor-v1
RuntimeDirectoryMode=0700
TimeoutStartSec=30s
UMask=0077
Nice=10
CPUQuota=10%
MemoryMax=128M
TasksMax=16
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trusted-web-monitor-drill-v1
