# Copy to /etc/verbalsage/ai-operations-alert-delivery.env.
# Set owner root:root and mode 0600.
# POSTGRES_DSN remains owned by /opt/chat-memory/.env.
AI_OPERATIONS_ALERT_DELIVERY_ENABLED=authorized
AI_OPERATIONS_RESEND_API_KEY=
AI_OPERATIONS_ALERT_TO_EMAIL=
AI_OPERATIONS_ALERT_FROM_EMAIL=LifeSwitch <no-reply@mail.lifeswitch.com>
AI_OPERATIONS_ALERT_DELIVERY_BATCH_SIZE=10
# AI_OPERATIONS_ALERT_DRILL_ENABLED is set only by the drill service.
