[Unit]
Description=Route one governed OpenAI Memory V1 V5.2 packet
ConditionPathExists=/etc/chat-memory/enable-openai-v5-2-packet-router-timer-v1

[Timer]
OnBootSec=12min
OnUnitInactiveSec=1min
RandomizedDelaySec=10s
Persistent=true
Unit=memory-v1-openai-v5-2-packet-router.service

[Install]
WantedBy=timers.target
