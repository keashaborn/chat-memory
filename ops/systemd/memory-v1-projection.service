[Unit]
Description=Memory V1 owner-scoped claim projection outbox drain
After=network-online.target brains.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/chat-memory
EnvironmentFile=/opt/chat-memory/.env
Environment=PYTHONPATH=/opt/chat-memory
# Lease expiry is deliberately longer than TimeoutStartSec, preventing a live
# timed-out worker from overlapping its own reclaimed work.
ExecStart=/opt/chat-memory/venv/bin/python /opt/chat-memory/scripts/memory_v1_projection_worker.py --drain --limit 25 --lease-seconds 600
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
