[Unit]
Description=Refresh the trusted-web NIH ODS source cache
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/lifeswitch/releases/@COMMIT@
EnvironmentFile=/opt/chat-memory/.env
Environment=PYTHONPATH=/opt/lifeswitch/releases/@COMMIT@
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/lifeswitch/runtimes/@COMMIT@/venv/bin/python /opt/lifeswitch/releases/@COMMIT@/scripts/refresh_trusted_web_ods_cache.py
TimeoutStartSec=1min
UMask=0077
Nice=10
CPUQuota=10%
MemoryMax=128M
TasksMax=16
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trusted-web-ods-cache
