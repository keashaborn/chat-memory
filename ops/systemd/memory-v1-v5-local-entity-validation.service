[Unit]
Description=Memory V1 private new named-entity validation and resolution
After=brains.service memory-v1-v5-local-packet-router.service memory-v1-v5-local-inference-tunnel.service
Requires=memory-v1-v5-local-inference-tunnel.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/chat-memory
EnvironmentFile=/opt/chat-memory/.env
Environment=PYTHONPATH=/opt/chat-memory
Environment=MEMORY_V1_V5_LOCAL_ENTITY_VALIDATION_APPLY=memory_v1_v5_local_entity_validation_apply_v1
LoadCredential=local_api_key:/etc/memory-v1-local-inference/api-key
RuntimeDirectory=memory-v1-v5-local-entity-validation
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock -n /run/memory-v1-v5-local-entity-validation/worker.lock /opt/chat-memory/venv/bin/python /opt/chat-memory/scripts/memory_v1_v5_local_entity_validation.py --apply
TimeoutStartSec=7min
UMask=0077
Nice=10
CPUQuota=20%
MemoryMax=384M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/ubuntu/memory-v1-reviews /etc/memory-v1-local-inference/api-key
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
