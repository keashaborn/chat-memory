[Unit]
Description=Verbal Sage Memory V1 private GPU inference (VS-Memory-GPU)
After=network-online.target nvidia-persistenced.service
Wants=network-online.target

[Service]
Type=simple
User=memory-inference
Group=memory-inference
UMask=0077
WorkingDirectory=/opt/vs-memory-inference
Environment=LD_LIBRARY_PATH=/opt/vs-memory-inference/runtime/b10066-cuda:/usr/local/cuda-13.0/targets/x86_64-linux/lib:/usr/local/cuda/lib
ExecStartPre=/usr/bin/test -s /etc/vs-memory-inference/api-keys
ExecStartPre=/usr/bin/sha256sum --check --strict /etc/vs-memory-inference/pinned.sha256
ExecStart=/opt/vs-memory-inference/runtime/b10066-cuda/llama-server \
  --model /opt/vs-memory-inference/models/qwen3-14b-530227a/Qwen3-14B-Q4_K_M.gguf \
  --alias qwen3-14b-local-extractor \
  --host 127.0.0.1 \
  --port 18080 \
  --api-key-file /etc/vs-memory-inference/api-keys \
  --ctx-size 32768 \
  --n-gpu-layers 99 \
  --flash-attn on \
  --parallel 1 \
  --reasoning off \
  --reasoning-budget 0 \
  --no-webui \
  --no-slots \
  --cors-origins localhost \
  --no-cors-credentials \
  --timeout 600
Restart=on-failure
RestartSec=5s
TimeoutStartSec=10min
TimeoutStopSec=2min
KillSignal=SIGTERM
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
# Keep the host /dev tree visible so CUDA can discover the NVIDIA devices.
# DevicePolicy=closed plus the explicit DeviceAllow entries below remains the
# enforcement boundary for device access.
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-modeset rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
TasksMax=256
MemoryMax=14G

[Install]
WantedBy=multi-user.target
