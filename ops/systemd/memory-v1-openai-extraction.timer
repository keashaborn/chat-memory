[Unit]
Description=Drain one governed OpenAI Memory V1 extraction job
ConditionPathExists=/etc/chat-memory/enable-openai-extraction-timer-v1

[Timer]
OnBootSec=5min
OnUnitInactiveSec=2min
RandomizedDelaySec=10s
Persistent=true
Unit=memory-v1-openai-extraction.service

[Install]
WantedBy=timers.target
