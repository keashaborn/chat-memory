[Unit]
Description=Memory V1 owner-scoped OpenAI V5.2 packet router
After=brains.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/chat-memory
EnvironmentFile=/opt/chat-memory/.env
EnvironmentFile=/etc/chat-memory/memory-openai-extraction.env
Environment=PYTHONPATH=/opt/chat-memory
Environment=MEMORY_V1_OPENAI_V5_2_PACKET_ROUTER_APPLY=memory_v1_openai_v5_2_packet_router_apply_v1
RuntimeDirectory=memory-v1-openai-v5-2-packet-router
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock -n /run/memory-v1-openai-v5-2-packet-router/worker.lock /opt/chat-memory/venv/bin/python /opt/chat-memory/scripts/memory_v1_openai_v5_2_packet_router_v1.py --owner-user-id ${MEMORY_V1_OPENAI_OWNER_ALLOWLIST} --packet-id ${MEMORY_V1_OPENAI_PACKET_ID} --apply
TimeoutStartSec=5min
UMask=0077
Nice=10
CPUQuota=20%
MemoryMax=512M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
