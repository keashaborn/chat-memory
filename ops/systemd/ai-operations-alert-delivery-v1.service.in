[Unit]
Description=Deliver private AI Operations incident email alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/lifeswitch/releases/@COMMIT@
EnvironmentFile=/opt/chat-memory/.env
EnvironmentFile=-/etc/verbalsage/ai-operations-alert-delivery.env
Environment=PYTHONPATH=/opt/lifeswitch/releases/@COMMIT@
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/flock -n /run/ai-operations-alert-delivery-v1/job.lock /opt/lifeswitch/runtimes/@COMMIT@/venv/bin/python /opt/lifeswitch/releases/@COMMIT@/scripts/ai_operations_alert_delivery_job_v1.py
RuntimeDirectory=ai-operations-alert-delivery-v1
RuntimeDirectoryMode=0700
TimeoutStartSec=2min
UMask=0077
Nice=10
CPUQuota=10%
MemoryMax=128M
TasksMax=16
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-operations-alert-delivery-v1
